<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>AgriStorage — Storage Owner Portal</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Josefin+Sans:wght@300;400;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
:root{
  --s1:#1a0a2e;--s2:#3b1f69;--s3:#6d3cac;--s4:#a78bfa;--s5:#e0d7ff;
  --teal:#0d9488;--orange:#ea580c;--green:#16a34a;--red:#dc2626;
  --cream:#f5f0ff;--dark:#12072a;--white:#fff;--gray:#7c6e94;
  --shadow:0 8px 32px rgba(26,10,46,.18);--nav-silver:#c8b8e8;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'DM Sans',sans-serif;background:var(--cream);color:var(--dark);min-height:100vh;overflow-x:hidden;}

/* SPLASH */
#splash{position:fixed;inset:0;z-index:9999;background:var(--s1);display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;}
.hexgrid{position:absolute;inset:0;overflow:hidden;}
.hex{position:absolute;width:60px;height:69px;clip-path:polygon(50% 0%,100% 25%,100% 75%,50% 100%,0% 75%,0% 25%);background:rgba(167,139,250,.07);animation:hex-float linear infinite;}
@keyframes hex-float{0%{transform:translateY(110vh) rotate(0deg)}100%{transform:translateY(-200px) rotate(180deg)}}
.sc{position:relative;z-index:2;text-align:center;}
.sring{width:110px;height:110px;border-radius:50%;border:2px solid rgba(167,139,250,.45);display:flex;align-items:center;justify-content:center;margin:0 auto 24px;animation:rp 2.5s ease-in-out infinite;position:relative;}
.sring::before{content:'';position:absolute;inset:-10px;border-radius:50%;border:1px solid rgba(167,139,250,.15);animation:rp 2.5s .6s ease-in-out infinite;}
@keyframes rp{0%,100%{box-shadow:0 0 0 0 rgba(167,139,250,.3)}50%{box-shadow:0 0 0 18px rgba(167,139,250,0)}}
.sico{font-size:48px;}
.stitle{font-family:'Josefin Sans',sans-serif;font-size:clamp(26px,6vw,50px);font-weight:700;color:#fff;letter-spacing:5px;text-transform:uppercase;}
.stitle span{display:inline-block;animation:ltin .55s cubic-bezier(.34,1.56,.64,1) both;}
@keyframes ltin{0%{opacity:0;transform:translateY(36px) scale(.8)}100%{opacity:1;transform:none}}
.ssub{font-family:'Josefin Sans',sans-serif;font-size:clamp(10px,2vw,14px);letter-spacing:4px;color:var(--s4);text-transform:uppercase;margin-top:10px;opacity:0;animation:fin .8s ease 1.5s both;}
.sbar{margin-top:28px;width:150px;height:3px;background:rgba(255,255,255,.1);border-radius:2px;overflow:hidden;opacity:0;animation:fin .5s ease 1.8s both;}
.sbarf{height:100%;background:linear-gradient(90deg,var(--s4),var(--orange));width:0%;animation:lb 2.5s ease 1.8s both;}
@keyframes lb{0%{width:0%}100%{width:100%}}
.swelcome{position:absolute;bottom:60px;left:0;right:0;text-align:center;font-family:'Cormorant Garamond',serif;font-size:clamp(14px,3vw,20px);color:rgba(255,255,255,.6);letter-spacing:3px;opacity:0;animation:fin .8s ease 2s both;}
.smade{position:absolute;bottom:28px;left:0;right:0;text-align:center;font-family:'Josefin Sans',sans-serif;font-size:11px;letter-spacing:5px;color:rgba(167,139,250,.5);text-transform:uppercase;opacity:0;animation:fin .8s ease 2.5s both;}
@keyframes fin{0%{opacity:0;transform:translateY(8px)}100%{opacity:1;transform:none}}
.sexit{animation:so .6s ease both;}
@keyframes so{0%{opacity:1;transform:scale(1)}100%{opacity:0;transform:scale(1.05)}}

#app{display:none;flex-direction:column;min-height:100vh;}
.screen{display:none;flex:1;flex-direction:column;}
.screen.active{display:flex;animation:fin .4s ease;}

/* LOGIN */
#loginScreen{background:linear-gradient(160deg,var(--s1) 0%,var(--s2) 55%,var(--s3) 100%);align-items:center;justify-content:center;padding:24px;min-height:100vh;position:relative;overflow:hidden;}
.lbg{position:absolute;font-family:'Josefin Sans',sans-serif;font-size:clamp(60px,15vw,160px);font-weight:700;letter-spacing:20px;color:rgba(255,255,255,.025);text-transform:uppercase;white-space:nowrap;top:50%;left:50%;transform:translate(-50%,-50%);pointer-events:none;}
.lcard{background:rgba(255,255,255,.97);border-radius:28px;padding:44px 40px;width:100%;max-width:440px;box-shadow:0 24px 64px rgba(0,0,0,.3);position:relative;z-index:1;}
.pbdg{display:inline-flex;align-items:center;gap:6px;background:var(--s1);color:var(--s4);padding:5px 14px;border-radius:20px;font-size:.75rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin-bottom:20px;font-family:'Josefin Sans',sans-serif;}
.lcard h1{font-family:'Cormorant Garamond',serif;font-size:2.1rem;font-weight:700;color:var(--s1);line-height:1.15;margin-bottom:6px;}
.lcard .lsub{color:var(--gray);font-size:.88rem;margin-bottom:28px;}
.fg{margin-bottom:18px;}
.fg label{display:block;font-size:.78rem;font-weight:700;color:var(--s1);margin-bottom:7px;letter-spacing:.5px;text-transform:uppercase;}
.fi{width:100%;padding:13px 16px;border:2px solid var(--s5);border-radius:12px;font-size:.92rem;font-family:'DM Sans',sans-serif;outline:none;transition:border-color .2s;background:#faf8ff;}
.fi:focus{border-color:var(--s3);}
.orow{display:flex;gap:10px;margin-bottom:20px;}
.odig{flex:1;height:54px;text-align:center;font-size:1.4rem;font-weight:700;border:2px solid var(--s5);border-radius:12px;outline:none;transition:border-color .2s;font-family:'DM Sans',sans-serif;background:#faf8ff;}
.odig:focus{border-color:var(--s3);}
.bmain{width:100%;padding:15px;background:linear-gradient(135deg,var(--s1),var(--s2));color:#fff;border:none;border-radius:14px;font-size:1rem;font-weight:600;cursor:pointer;transition:transform .15s;font-family:'Josefin Sans',sans-serif;letter-spacing:1px;}
.bmain:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(26,10,46,.35);}
.bout{width:100%;padding:13px;background:transparent;color:var(--s2);border:2px solid var(--s4);border-radius:14px;font-size:.9rem;font-weight:600;cursor:pointer;margin-top:10px;font-family:'DM Sans',sans-serif;transition:all .2s;}
.bout:hover{background:var(--s5);}
.dor{display:flex;align-items:center;gap:12px;margin:16px 0;color:var(--gray);font-size:.82rem;}
.dor::before,.dor::after{content:'';flex:1;height:1px;background:var(--s5);}

/* NAVBAR */
.navbar{background:linear-gradient(135deg,var(--s1),var(--s2));padding:0 28px;height:66px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:200;box-shadow:0 4px 20px rgba(0,0,0,.25);}
.nbrand{display:flex;align-items:center;gap:10px;cursor:pointer;}
.ntitle{font-family:'Josefin Sans',sans-serif;font-size:1.2rem;font-weight:700;color:var(--nav-silver);letter-spacing:2px;text-transform:uppercase;}
.nlinks{display:flex;align-items:center;gap:4px;}
.nb{padding:8px 16px;border-radius:10px;color:var(--nav-silver);font-size:.85rem;font-weight:600;cursor:pointer;border:none;background:transparent;font-family:'Josefin Sans',sans-serif;letter-spacing:.5px;transition:all .2s;}
.nb:hover,.nb.on{background:rgba(255,255,255,.15);color:#fff;}
.nr{display:flex;align-items:center;gap:10px;}
.nav-av{width:38px;height:38px;border-radius:50%;background:var(--s4);color:var(--s1);font-weight:700;display:flex;align-items:center;justify-content:center;font-size:.95rem;cursor:pointer;}
.opbdg{background:rgba(167,139,250,.2);border:1px solid rgba(167,139,250,.4);color:var(--s4);padding:4px 12px;border-radius:20px;font-size:.72rem;font-weight:700;letter-spacing:2px;font-family:'Josefin Sans',sans-serif;text-transform:uppercase;}

/* CONTENT */
.cnt{flex:1;padding:32px 28px;max-width:1200px;margin:0 auto;width:100%;}

/* HERO / STATUS BAR */
.owner-hero{background:linear-gradient(135deg,var(--s1),var(--s2));border-radius:24px;padding:36px 40px;color:#fff;margin-bottom:28px;position:relative;overflow:hidden;}
.owner-hero::before{content:'';position:absolute;right:-50px;top:-50px;width:260px;height:260px;border-radius:50%;background:rgba(167,139,250,.1);}
.owner-hero::after{content:'🏭';position:absolute;right:40px;bottom:-16px;font-size:130px;opacity:.08;}
.oh-label{font-family:'Josefin Sans',sans-serif;font-size:.78rem;letter-spacing:3px;color:var(--s5);text-transform:uppercase;margin-bottom:6px;}
.oh-title{font-family:'Cormorant Garamond',serif;font-size:clamp(1.4rem,3.5vw,2.2rem);font-weight:700;margin-bottom:6px;}
.oh-sub{opacity:.7;font-size:.9rem;margin-bottom:20px;}

/* CAPACITY METER */
.cap-meter{background:rgba(255,255,255,.1);border-radius:20px;padding:20px;margin-top:20px;}
.cm-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;}
.cm-label{font-family:'Josefin Sans',sans-serif;font-size:.82rem;letter-spacing:1px;text-transform:uppercase;color:rgba(255,255,255,.7);}
.cm-val{font-family:'Josefin Sans',sans-serif;font-size:1.1rem;font-weight:700;color:#fff;}
.meter-bar{height:10px;background:rgba(255,255,255,.15);border-radius:6px;overflow:hidden;}
.meter-fill{height:100%;border-radius:6px;transition:width .8s ease;}

/* STATS */
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;margin-bottom:28px;}
.scard{background:#fff;border-radius:18px;padding:22px 18px;box-shadow:var(--shadow);transition:transform .2s;border-bottom:3px solid var(--s4);}
.scard:hover{transform:translateY(-4px);}
.sci{font-size:28px;margin-bottom:10px;}
.scv{font-size:1.9rem;font-weight:700;color:var(--s2);font-family:'Josefin Sans',sans-serif;}
.scl{font-size:.8rem;color:var(--gray);margin-top:3px;}

/* REAL-TIME UPDATE PANEL */
.update-panel{background:#fff;border-radius:20px;padding:28px;box-shadow:var(--shadow);margin-bottom:28px;}
.up-title{font-family:'Cormorant Garamond',serif;font-size:1.45rem;font-weight:700;color:var(--s1);margin-bottom:4px;}
.up-sub{color:var(--gray);font-size:.85rem;margin-bottom:24px;}
.update-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;}
.ucard{border:2px solid var(--s5);border-radius:16px;padding:20px;transition:border-color .2s;}
.ucard:hover{border-color:var(--s4);}
.ucard-title{font-family:'Josefin Sans',sans-serif;font-size:.85rem;font-weight:700;color:var(--s1);letter-spacing:.5px;text-transform:uppercase;margin-bottom:14px;}
.slider-wrap{margin-bottom:16px;}
.slider-lbl{display:flex;justify-content:space-between;font-size:.82rem;color:var(--gray);margin-bottom:8px;}
.slider-val{font-weight:700;color:var(--s2);}
input[type=range]{width:100%;accent-color:var(--s3);cursor:pointer;}
.toggle-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid #f0eaff;}
.toggle-row:last-child{border-bottom:none;}
.tg-label{font-size:.88rem;font-weight:500;}
.toggle{position:relative;width:44px;height:24px;}
.toggle input{opacity:0;width:0;height:0;}
.tslider{position:absolute;inset:0;background:#ddd;border-radius:12px;cursor:pointer;transition:.3s;}
.tslider::before{content:'';position:absolute;width:18px;height:18px;left:3px;bottom:3px;background:#fff;border-radius:50%;transition:.3s;}
input:checked+.tslider{background:var(--s3);}
input:checked+.tslider::before{transform:translateX(20px);}
.save-btn{padding:13px 28px;background:linear-gradient(135deg,var(--s2),var(--s3));color:#fff;border:none;border-radius:12px;font-weight:600;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all .2s;font-size:.9rem;}
.save-btn:hover{box-shadow:0 6px 18px rgba(26,10,46,.3);transform:translateY(-2px);}
.live-dot{width:8px;height:8px;border-radius:50%;background:var(--green);display:inline-block;margin-right:6px;animation:blink .8s ease-in-out infinite;}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}

/* BOOKINGS TABLE */
.bookings-panel{background:#fff;border-radius:20px;overflow:hidden;box-shadow:var(--shadow);margin-bottom:28px;}
.bp-header{padding:22px 24px;border-bottom:2px solid #f0eaff;display:flex;justify-content:space-between;align-items:center;}
.bp-header h3{font-family:'Josefin Sans',sans-serif;font-size:1rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--s1);}
table{width:100%;border-collapse:collapse;}
th{background:var(--s1);color:var(--nav-silver);padding:12px 18px;font-family:'Josefin Sans',sans-serif;font-size:.78rem;letter-spacing:1px;text-align:left;}
td{padding:12px 18px;border-bottom:1px solid #f0eaff;font-size:.88rem;}
tr:last-child td{border-bottom:none;}
.status-pill{padding:4px 12px;border-radius:16px;font-size:.74rem;font-weight:700;}
.sp-g{background:#dcfce7;color:#15803d;}
.sp-y{background:#fef3c7;color:#92400e;}
.sp-b{background:#dbeafe;color:#1d4ed8;}
.sp-r{background:#fee2e2;color:#dc2626;}
.action-btn{padding:5px 12px;border-radius:8px;font-size:.75rem;font-weight:600;cursor:pointer;border:none;font-family:'DM Sans',sans-serif;transition:all .2s;margin-right:4px;}
.ab-approve{background:#dcfce7;color:#15803d;}
.ab-approve:hover{background:#bbf7d0;}
.ab-reject{background:#fee2e2;color:#dc2626;}
.ab-reject:hover{background:#fecaca;}

/* REVENUE SECTION */
.rev-grid{display:grid;grid-template-columns:2fr 1fr;gap:20px;}
.rev-card{background:#fff;border-radius:20px;padding:24px;box-shadow:var(--shadow);}
.rev-item{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid #f0eaff;}
.rev-item:last-child{border-bottom:none;}
.ri-label{font-size:.88rem;color:var(--gray);}
.ri-val{font-weight:700;color:var(--s1);}

.toast{position:fixed;top:82px;right:28px;background:var(--s1);color:#fff;padding:12px 22px;border-radius:14px;font-size:.88rem;z-index:3000;transform:translateX(130%);transition:transform .3s ease;max-width:300px;}
.toast.on{transform:none;}
@media(max-width:768px){.update-grid{grid-template-columns:1fr;}.rev-grid{grid-template-columns:1fr;}.cnt{padding:20px 16px;}.navbar{padding:0 16px;}.nlinks{display:none;}}
</style>
</head>
<body>

<!-- SPLASH -->
<div id="splash">
  <div class="hexgrid" id="hexGrid"></div>
  <div class="sc">
    <div class="sring"><div class="sico">🏭</div></div>
    <div class="stitle" id="sTitle"></div>
    <div class="ssub">Cold Storage Management System</div>
    <div class="sbar"><div class="sbarf"></div></div>
  </div>
  <div class="swelcome">Welcome to Agri Storage</div>
  <div class="smade">Made by Sparks</div>
</div>

<!-- APP -->
<div id="app">
  <!-- LOGIN -->
  <div id="loginScreen" class="screen active" style="display:flex;">
    <div class="lbg">OWNER</div>
    <div class="lcard">
      <div class="pbdg">🏭 Storage Owner Portal</div>
      <h1>Manage Your<br/>Cold Storage</h1>
      <p class="lsub">Real-time capacity management and booking dashboard</p>
      <div id="os1">
        <div class="fg"><label>Owner / Business Name</label><input class="fi" id="oName" type="text" placeholder="e.g. GreenFreeze Pvt Ltd"/></div>
        <div class="fg"><label>Gmail Address</label><input class="fi" id="oEmail" type="email" placeholder="owner@gmail.com"/></div>
        <button class="bmain" onclick="oSendOTP()">Send OTP →</button>
        <div class="dor">or</div>
        <button class="bout" onclick="oDemo()">🚀 Quick Demo Login</button>
      </div>
      <div id="os2" style="display:none;">
        <p style="font-size:.86rem;color:var(--gray);margin-bottom:16px;" id="oOtpInfo">OTP sent to your Gmail</p>
        <div class="orow">
          <input class="odig" id="od1" maxlength="1" oninput="onxt(this,'od2')"/>
          <input class="odig" id="od2" maxlength="1" oninput="onxt(this,'od3')"/>
          <input class="odig" id="od3" maxlength="1" oninput="onxt(this,'od4')"/>
          <input class="odig" id="od4" maxlength="1" oninput="onxt(this,'od5')"/>
          <input class="odig" id="od5" maxlength="1" oninput="onxt(this,'od6')"/>
          <input class="odig" id="od6" maxlength="1"/>
        </div>
        <button class="bmain" onclick="oVerify()">Verify & Login →</button>
        <button class="bout" onclick="oBack()">← Back</button>
      </div>
    </div>
  </div>

  <!-- MAIN -->
  <div id="mainScreen" class="screen">
    <nav class="navbar">
      <div class="nbrand" onclick="oTab('dash')">
        <span style="font-size:22px;">🏭</span>
        <span class="ntitle">AgriStorage</span>
      </div>
      <div class="nlinks">
        <button class="nb on" id="onb-dash" onclick="oTab('dash')">Dashboard</button>
        <button class="nb" id="onb-update" onclick="oTab('update')">Update Facility</button>
        <button class="nb" id="onb-bookings" onclick="oTab('bookings')">Bookings</button>
        <button class="nb" id="onb-revenue" onclick="oTab('revenue')">Revenue</button>
      </div>
      <div class="nr">
        <span class="opbdg">Owner</span>
        <div class="nav-av" id="oAvatar">O</div>
        <button class="nb" onclick="oLogout()" style="color:#fca5a5;padding:8px 10px;">⏻</button>
      </div>
    </nav>

    <!-- DASHBOARD -->
    <div id="otab-dash" class="cnt">
      <div class="owner-hero">
        <div class="oh-label" id="oGreet">GOOD MORNING, OWNER</div>
        <h1 class="oh-title" id="oFacilityName">GreenFreeze Cold Storage</h1>
        <p class="oh-sub">Guntur, Andhra Pradesh · <span class="live-dot"></span>Live Updates Active</p>
        <div class="cap-meter">
          <div class="cm-row"><span class="cm-label">Storage Capacity Used</span><span class="cm-val" id="capPct">64%</span></div>
          <div class="meter-bar"><div class="meter-fill" id="capBar" style="width:64%;background:linear-gradient(90deg,#a78bfa,#60a5fa);"></div></div>
          <div class="cm-row" style="margin-top:10px;margin-bottom:0;">
            <span style="font-size:.78rem;opacity:.6;">3,200 T used</span>
            <span style="font-size:.78rem;opacity:.6;">1,800 T free of 5,000 T total</span>
          </div>
        </div>
      </div>

      <div class="stats-grid">
        <div class="scard"><div class="sci">📦</div><div class="scv" id="s1">1,800 T</div><div class="scl">Available Space</div></div>
        <div class="scard" style="border-color:var(--orange);"><div class="sci">🌾</div><div class="scv">14</div><div class="scl">Active Bookings</div></div>
        <div class="scard" style="border-color:var(--teal);"><div class="sci">💰</div><div class="scv">₹2.4L</div><div class="scl">Monthly Revenue</div></div>
        <div class="scard" style="border-color:var(--green);"><div class="sci">⭐</div><div class="scv">4.8</div><div class="scl">Farmer Rating</div></div>
        <div class="scard" style="border-color:var(--red);"><div class="sci">🔔</div><div class="scv" id="pendCount">3</div><div class="scl">Pending Requests</div></div>
      </div>

      <h2 style="font-family:'Cormorant Garamond',serif;font-size:1.4rem;margin-bottom:16px;">Recent Booking Activity</h2>
      <div class="bookings-panel">
        <div class="bp-header">
          <h3>📋 Recent Bookings</h3>
          <span style="font-size:.8rem;color:var(--gray);">Showing last 5 entries</span>
        </div>
        <table>
          <thead><tr><th>Farmer</th><th>Crop</th><th>Qty</th><th>Duration</th><th>Amount</th><th>Status</th><th>Action</th></tr></thead>
          <tbody id="recentBookings"></tbody>
        </table>
      </div>
    </div>

    <!-- UPDATE FACILITY -->
    <div id="otab-update" class="cnt" style="display:none;">
      <h1 style="font-family:'Cormorant Garamond',serif;font-size:2rem;margin-bottom:6px;">⚙️ Update Facility Info</h1>
      <p style="color:var(--gray);margin-bottom:24px;">Changes are reflected in real-time for farmers browsing storage listings.</p>

      <div class="update-panel">
        <p class="up-title">Real-Time Capacity Management</p>
        <p class="up-sub">Drag sliders to update — farmers see your availability instantly</p>
        <div class="update-grid">
          <div class="ucard">
            <div class="ucard-title">📦 Storage Capacity</div>
            <div class="slider-wrap">
              <div class="slider-lbl"><span>Total Capacity</span><span class="slider-val" id="slCapVal">5,000 T</span></div>
              <input type="range" min="500" max="20000" step="100" value="5000" oninput="updateSlider('slCapVal',this.value,'T')"/>
            </div>
            <div class="slider-wrap">
              <div class="slider-lbl"><span>Currently Used</span><span class="slider-val" id="slUsedVal">3,200 T</span></div>
              <input type="range" min="0" max="5000" step="50" value="3200" oninput="updateSlider('slUsedVal',this.value,'T');updateCapMeter(this.value,5000)"/>
            </div>
            <div class="slider-wrap">
              <div class="slider-lbl"><span>Min Booking</span><span class="slider-val" id="slMinVal">500 kg</span></div>
              <input type="range" min="100" max="5000" step="100" value="500" oninput="updateSlider('slMinVal',this.value,'kg')"/>
            </div>
          </div>
          <div class="ucard">
            <div class="ucard-title">🌡️ Temperature & Features</div>
            <div class="slider-wrap">
              <div class="slider-lbl"><span>Min Temp (°C)</span><span class="slider-val" id="slTminVal">-5°C</span></div>
              <input type="range" min="-20" max="0" step="1" value="-5" oninput="updateSlider('slTminVal',this.value,'°C')"/>
            </div>
            <div class="slider-wrap">
              <div class="slider-lbl"><span>Max Temp (°C)</span><span class="slider-val" id="slTmaxVal">8°C</span></div>
              <input type="range" min="1" max="20" step="1" value="8" oninput="updateSlider('slTmaxVal',this.value,'°C')"/>
            </div>
            <div class="slider-wrap">
              <div class="slider-lbl"><span>Price ₹/kg/month</span><span class="slider-val" id="slPriceVal">₹2.50</span></div>
              <input type="range" min="0.5" max="10" step="0.1" value="2.5" oninput="updatePriceSlider(this.value)"/>
            </div>
          </div>
        </div>

        <div class="ucard" style="margin-bottom:20px;">
          <div class="ucard-title">🔧 Facility Features</div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:4px;">
            <div class="toggle-row"><span class="tg-label">24/7 Security</span><label class="toggle"><input type="checkbox" checked/><span class="tslider"></span></label></div>
            <div class="toggle-row"><span class="tg-label">IoT Monitoring</span><label class="toggle"><input type="checkbox" checked/><span class="tslider"></span></label></div>
            <div class="toggle-row"><span class="tg-label">Loading Dock</span><label class="toggle"><input type="checkbox" checked/><span class="tslider"></span></label></div>
            <div class="toggle-row"><span class="tg-label">Transport Service</span><label class="toggle"><input type="checkbox"/><span class="tslider"></span></label></div>
            <div class="toggle-row"><span class="tg-label">Insurance Coverage</span><label class="toggle"><input type="checkbox" checked/><span class="tslider"></span></label></div>
            <div class="toggle-row"><span class="tg-label">Accept New Bookings</span><label class="toggle"><input type="checkbox" id="acceptBookings" checked/><span class="tslider"></span></label></div>
          </div>
        </div>

        <button class="save-btn" onclick="saveUpdates()">💾 Save & Publish Changes Live</button>
        <span style="font-size:.8rem;color:var(--gray);margin-left:14px;" id="saveStatus"></span>
      </div>
    </div>

    <!-- BOOKINGS -->
    <div id="otab-bookings" class="cnt" style="display:none;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
        <div>
          <h1 style="font-family:'Cormorant Garamond',serif;font-size:2rem;">📋 Booking Management</h1>
          <p style="color:var(--gray);">Review and manage all storage booking requests</p>
        </div>
        <div style="display:flex;gap:8px;">
          <button onclick="filterBook('all')" id="bf-all" style="padding:8px 16px;border-radius:10px;border:2px solid var(--s4);background:var(--s2);color:#fff;cursor:pointer;font-family:'DM Sans',sans-serif;font-size:.82rem;font-weight:600;">All</button>
          <button onclick="filterBook('pending')" id="bf-pending" style="padding:8px 16px;border-radius:10px;border:2px solid var(--s5);background:#fff;color:var(--s2);cursor:pointer;font-family:'DM Sans',sans-serif;font-size:.82rem;font-weight:600;">Pending</button>
          <button onclick="filterBook('approved')" id="bf-approved" style="padding:8px 16px;border-radius:10px;border:2px solid var(--s5);background:#fff;color:var(--s2);cursor:pointer;font-family:'DM Sans',sans-serif;font-size:.82rem;font-weight:600;">Approved</button>
        </div>
      </div>
      <div class="bookings-panel">
        <table>
          <thead><tr><th>Farmer</th><th>Crop</th><th>Qty</th><th>Check-in</th><th>Duration</th><th>Amount</th><th>Status</th><th>Actions</th></tr></thead>
          <tbody id="allBookings"></tbody>
        </table>
      </div>
    </div>

    <!-- REVENUE -->
    <div id="otab-revenue" class="cnt" style="display:none;">
      <h1 style="font-family:'Cormorant Garamond',serif;font-size:2rem;margin-bottom:24px;">💰 Revenue Overview</h1>
      <div class="stats-grid" style="margin-bottom:28px;">
        <div class="scard" style="border-color:var(--green);"><div class="sci">💰</div><div class="scv">₹2.4L</div><div class="scl">This Month</div></div>
        <div class="scard" style="border-color:var(--teal);"><div class="sci">📈</div><div class="scv">₹18.6L</div><div class="scl">This Year</div></div>
        <div class="scard"><div class="sci">📊</div><div class="scv">+14%</div><div class="scl">Growth vs Last Month</div></div>
        <div class="scard" style="border-color:var(--orange);"><div class="sci">🏆</div><div class="scv">₹3.1L</div><div class="scl">Projected Next Month</div></div>
      </div>
      <div class="rev-grid">
        <div class="rev-card">
          <h3 style="font-family:'Josefin Sans',sans-serif;font-size:.9rem;letter-spacing:1px;text-transform:uppercase;margin-bottom:16px;color:var(--s1);">📅 Monthly Breakdown</h3>
          <div id="revBreakdown"></div>
        </div>
        <div class="rev-card">
          <h3 style="font-family:'Josefin Sans',sans-serif;font-size:.9rem;letter-spacing:1px;text-transform:uppercase;margin-bottom:16px;color:var(--s1);">🌾 By Crop Type</h3>
          <div id="revByCrop"></div>
        </div>
      </div>
    </div>

  </div>
</div>

<div class="toast" id="toast"></div>

<script>
// SPLASH
const SL = "AGRI STORAGE".split('');
const sTEl = document.getElementById('sTitle');
SL.forEach((c,i)=>{const s=document.createElement('span');s.textContent=c===' '?'\u00A0':c;s.style.animationDelay=(i*.08+.3)+'s';sTEl.appendChild(s);});

// Hexagons
const hg = document.getElementById('hexGrid');
for(let i=0;i<22;i++){
  const h=document.createElement('div');h.className='hex';
  h.style.cssText=`left:${Math.random()*100}%;animation-duration:${10+Math.random()*14}s;animation-delay:${Math.random()*10}s;`;
  hg.appendChild(h);
}

setTimeout(()=>{
  document.getElementById('splash').classList.add('sexit');
  setTimeout(()=>{document.getElementById('splash').style.display='none';document.getElementById('app').style.display='flex';},600);
},4200);

// STATE
let oUser={name:'',email:'',otp:''};
let bookings=[
  {id:1,farmer:'Ravi Kumar',crop:'Tomatoes 🍅',qty:'8T',checkin:'2024-01-15',dur:'2 Months',amount:'₹32,000',status:'approved',phone:'9876543210'},
  {id:2,farmer:'Suresh Reddy',crop:'Onions 🧅',qty:'15T',checkin:'2024-01-18',dur:'3 Months',amount:'₹56,250',status:'pending',phone:'9765432109'},
  {id:3,farmer:'Priya Patel',crop:'Grapes 🍇',qty:'5T',checkin:'2024-01-20',dur:'1 Month',amount:'₹12,500',status:'approved',phone:'9654321098'},
  {id:4,farmer:'Anand Singh',crop:'Potatoes 🥔',qty:'20T',checkin:'2024-01-22',dur:'2 Months',amount:'₹50,000',status:'pending',phone:'9543210987'},
  {id:5,farmer:'Meena Devi',crop:'Chilies 🌶️',qty:'3T',checkin:'2024-01-25',dur:'1 Month',amount:'₹7,500',status:'checkedout',phone:'9432109876'},
  {id:6,farmer:'Vijay Sharma',crop:'Apples 🍎',qty:'10T',checkin:'2024-01-28',dur:'3 Months',amount:'₹75,000',status:'approved',phone:'9321098765'},
  {id:7,farmer:'Kavita Rao',crop:'Wheat 🌾',qty:'25T',checkin:'2024-02-01',dur:'6 Months',amount:'₹1,87,500',status:'pending',phone:'9210987654'},
];

// LOGIN
function oSendOTP(){
  const n=document.getElementById('oName').value.trim();
  const e=document.getElementById('oEmail').value.trim();
  if(!n){showToast('⚠️ Enter your name');return;}
  if(!e||!e.includes('@')){showToast('⚠️ Enter valid email');return;}
  oUser.name=n;oUser.email=e;
  oUser.otp=Math.floor(100000+Math.random()*900000).toString();
  document.getElementById('oOtpInfo').innerHTML=`OTP sent to <strong>${e}</strong> <small style="color:#a78bfa">(Demo: ${oUser.otp})</small>`;
  document.getElementById('os1').style.display='none';
  document.getElementById('os2').style.display='block';
  showToast('📧 OTP sent to '+e);
}
function oVerify(){
  const ent=['od1','od2','od3','od4','od5','od6'].map(id=>document.getElementById(id).value).join('');
  if(ent===oUser.otp||ent==='123456') oLoginSuccess();
  else{showToast('❌ Wrong OTP');['od1','od2','od3','od4','od5','od6'].forEach(id=>{document.getElementById(id).value='';});document.getElementById('od1').focus();}
}
function oDemo(){oUser.name='GreenFreeze Pvt Ltd';oUser.email='owner@greenfreezeguntur.com';oLoginSuccess();}
function oBack(){document.getElementById('os2').style.display='none';document.getElementById('os1').style.display='block';}
function onxt(el,nid){if(el.value&&nid)document.getElementById(nid).focus();}

function oLoginSuccess(){
  document.getElementById('loginScreen').classList.remove('active');
  document.getElementById('mainScreen').classList.add('active');
  document.getElementById('oAvatar').textContent=oUser.name[0].toUpperCase();
  document.getElementById('oFacilityName').textContent=oUser.name;
  const hr=new Date().getHours();
  const g=hr<12?'GOOD MORNING':hr<17?'GOOD AFTERNOON':'GOOD EVENING';
  document.getElementById('oGreet').textContent=`${g}, ${oUser.name.toUpperCase()}`;
  renderBookingsTable('all');
  renderRevenue();
  const pend=bookings.filter(b=>b.status==='pending').length;
  document.getElementById('pendCount').textContent=pend;
  showToast(`✅ Welcome, ${oUser.name}!`);
}
function oLogout(){if(confirm('Logout?')){document.getElementById('mainScreen').classList.remove('active');document.getElementById('loginScreen').classList.add('active');}}

function oTab(tab){
  ['dash','update','bookings','revenue'].forEach(t=>{
    document.getElementById('otab-'+t).style.display=t===tab?'block':'none';
    const b=document.getElementById('onb-'+t);if(b)b.classList.toggle('on',t===tab);
  });
}

// CAPACITY METER
function updateCapMeter(used,total){
  const pct=Math.round((used/total)*100);
  document.getElementById('capBar').style.width=pct+'%';
  document.getElementById('capPct').textContent=pct+'%';
  const color=pct>85?'linear-gradient(90deg,#f87171,#dc2626)':pct>60?'linear-gradient(90deg,#fbbf24,#f59e0b)':'linear-gradient(90deg,#a78bfa,#60a5fa)';
  document.getElementById('capBar').style.background=color;
}
function updateSlider(id,val,unit){document.getElementById(id).textContent=Number(val).toLocaleString()+' '+unit;}
function updatePriceSlider(val){document.getElementById('slPriceVal').textContent='₹'+parseFloat(val).toFixed(2);}

function saveUpdates(){
  document.getElementById('saveStatus').innerHTML='<span style="color:var(--green);">✅ Changes published live!</span>';
  showToast('✅ Facility info updated — farmers can see the changes');
  setTimeout(()=>document.getElementById('saveStatus').textContent='',4000);
}

// BOOKINGS
function renderBookingsTable(filter){
  const arr = filter==='all'?bookings:bookings.filter(b=>b.status===filter);
  const rows = arr.map(b=>{
    const sc=b.status==='approved'?'sp-g':b.status==='pending'?'sp-y':b.status==='checkedout'?'sp-b':'sp-r';
    const sl=b.status==='approved'?'Approved':b.status==='pending'?'Pending':b.status==='checkedout'?'Checked Out':'Rejected';
    const actions = b.status==='pending'?
      `<button class="action-btn ab-approve" onclick="approveBook(${b.id})">✅ Approve</button><button class="action-btn ab-reject" onclick="rejectBook(${b.id})">❌ Reject</button>`:
      `<button class="action-btn" style="background:#e8f0fe;color:#1d4ed8;" onclick="showToast('📞 Calling ${b.phone}')">📞 Call</button>`;
    return `<tr><td><strong>${b.farmer}</strong></td><td>${b.crop}</td><td>${b.qty}</td><td>${b.checkin}</td><td>${b.dur}</td><td><strong>${b.amount}</strong></td><td><span class="status-pill ${sc}">${sl}</span></td><td>${actions}</td></tr>`;
  }).join('');
  const tbody=document.getElementById('allBookings');
  const recentTbody=document.getElementById('recentBookings');
  if(tbody)tbody.innerHTML=rows;
  if(recentTbody)recentTbody.innerHTML=bookings.slice(0,5).map(b=>{
    const sc=b.status==='approved'?'sp-g':b.status==='pending'?'sp-y':b.status==='checkedout'?'sp-b':'sp-r';
    const sl=b.status==='approved'?'Approved':b.status==='pending'?'Pending':b.status==='checkedout'?'Checked Out':'Rejected';
    const actions=b.status==='pending'?
      `<button class="action-btn ab-approve" onclick="approveBook(${b.id})">✅</button><button class="action-btn ab-reject" onclick="rejectBook(${b.id})">❌</button>`:
      `<button class="action-btn" style="background:#e8f0fe;color:#1d4ed8;">📞</button>`;
    return `<tr><td><strong>${b.farmer}</strong></td><td>${b.crop}</td><td>${b.qty}</td><td>${b.dur}</td><td>${b.amount}</td><td><span class="status-pill ${sc}">${sl}</span></td><td>${actions}</td></tr>`;
  }).join('');
}

function approveBook(id){
  const b=bookings.find(x=>x.id===id);if(!b)return;
  b.status='approved';
  renderBookingsTable('all');
  const pend=bookings.filter(b=>b.status==='pending').length;
  document.getElementById('pendCount').textContent=pend;
  showToast('✅ Booking approved! Farmer notified via email.');
}
function rejectBook(id){
  const b=bookings.find(x=>x.id===id);if(!b)return;
  b.status='rejected';
  renderBookingsTable('all');
  showToast('❌ Booking rejected. Farmer notified.');
}
function filterBook(f){renderBookingsTable(f);}

// REVENUE
function renderRevenue(){
  const months=[
    {m:'August',rev:'₹1.8L'},{m:'September',rev:'₹2.0L'},{m:'October',rev:'₹2.2L'},
    {m:'November',rev:'₹2.1L'},{m:'December',rev:'₹2.3L'},{m:'January',rev:'₹2.4L'},
  ];
  document.getElementById('revBreakdown').innerHTML=months.map(m=>`
    <div class="rev-item">
      <span class="ri-label">${m.m} 2024</span>
      <span class="ri-val">${m.rev}</span>
    </div>`).join('');
  const crops=[
    {c:'Tomatoes 🍅',pct:'28%',rev:'₹67,200'},
    {c:'Grapes 🍇',pct:'22%',rev:'₹52,800'},
    {c:'Onions 🧅',pct:'18%',rev:'₹43,200'},
    {c:'Potatoes 🥔',pct:'16%',rev:'₹38,400'},
    {c:'Others',pct:'16%',rev:'₹38,400'},
  ];
  document.getElementById('revByCrop').innerHTML=crops.map(c=>`
    <div class="rev-item">
      <div>
        <div class="ri-label">${c.c}</div>
        <div style="background:#f0eaff;border-radius:4px;height:4px;width:100%;margin-top:4px;overflow:hidden;">
          <div style="width:${c.pct};height:100%;background:var(--s3);border-radius:4px;"></div>
        </div>
      </div>
      <span class="ri-val" style="margin-left:12px;">${c.rev}</span>
    </div>`).join('');
}

function showToast(msg,dur=3000){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('on');setTimeout(()=>t.classList.remove('on'),dur);}
</script>
</body>
</html>
